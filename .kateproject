{
	"name": "Swan skateboarder",
	"build": {
		"directory": ".",
		"targets": [
			{
				"name": "Run game",
				"build_cmd": "love ."
			},
			{
				"name": "Run game (with drawn hitboxes)",
				"build_cmd": "love . --drawHitboxes"
			},
			{
				"name": "Run game (with screenshot by q)",
				"build_cmd": "love . --screenshotByQ"
			}
		]
	}
}